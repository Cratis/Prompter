<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cratis -->
    <PackageVersion Include="Cratis.Fundamentals" Version="7.27.0" />
    <!-- Discord -->
    <PackageVersion Include="NetCord" Version="1.0.0-beta.28" />
    <PackageVersion Include="NetCord.Hosting" Version="1.0.0-beta.28" />
    <PackageVersion Include="NetCord.Hosting.Services" Version="1.0.0-beta.28" />
    <PackageVersion Include="NetCord.Services" Version="1.0.0-beta.28" />
    <!-- AI -->
    <PackageVersion Include="Anthropic" Version="13.3.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <!-- Evaluation (dev-only Eval harness) -->
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation" Version="10.11.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Hosting -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <!-- Storage -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <!-- Deployment / Pulumi (versions kept in step with Studio's Deployment stack) -->
    <PackageVersion Include="Pulumi" Version="3.116.2" />
    <PackageVersion Include="Pulumi.Kubernetes" Version="4.34.2" />
    <PackageVersion Include="Pulumi.Random" Version="4.21.4" />
    <!-- Analysis -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.317" />
    <!-- Testing -->
    <PackageVersion Include="Cratis.Specifications" Version="5.1.0" />
    <PackageVersion Include="Cratis.Specifications.XUnit.v3" Version="5.1.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
</Project>