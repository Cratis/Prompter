{
  "uid": "prompter-operations",
  "title": "Prompter operations (aggregate only)",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["prompter", "operations"],
  "timezone": "utc",
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Provider attempts / sec (not logical requests)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }, "targets": [{ "refId": "A", "expr": "sum by (provider, model, task, account) (rate(prompter_provider_attempts_total[5m]))", "legendFormat": "{{provider}} {{model}} {{task}} {{account}}" }] },
    { "id": 2, "type": "timeseries", "title": "Logical operations / sec", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }, "targets": [{ "refId": "A", "expr": "sum by (provider, task) (rate(prompter_provider_operations_total[5m]))", "legendFormat": "{{provider}} {{task}}" }] },
    { "id": 3, "type": "timeseries", "title": "Provider attempt p95 seconds", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(prompter_provider_duration_seconds_bucket[5m])))", "legendFormat": "{{provider}}" }] },
    { "id": 4, "type": "timeseries", "title": "Bounded failures, retries, refusals and protection", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }, "targets": [{ "refId": "A", "expr": "sum by (source, reason) (increase(prompter_events_total[10m]))", "legendFormat": "{{source}} {{reason}}" }] },
    { "id": 5, "type": "timeseries", "title": "Known tokens (cache and reasoning are subsets, do not sum kinds)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }, "targets": [{ "refId": "A", "expr": "sum by (provider, kind) (increase(prompter_provider_tokens_total[1h]))", "legendFormat": "{{provider}} {{kind}}" }] },
    { "id": 6, "type": "timeseries", "title": "Usage knowledge (unknown is not free)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }, "targets": [{ "refId": "A", "expr": "sum by (provider, knowledge) (increase(prompter_provider_usage_total[1h]))", "legendFormat": "{{provider}} {{knowledge}}" }] },
    { "id": 7, "type": "timeseries", "title": "UTC-day reserved exposure USD (not invoices)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 }, "targets": [{ "refId": "A", "expr": "max(prompter_state_anthropic_usd)", "legendFormat": "interactive Anthropic" }, { "refId": "B", "expr": "max(prompter_state_voyage_usd)", "legendFormat": "interactive Voyage" }, { "refId": "C", "expr": "max(prompter_state_index_usd)", "legendFormat": "index Voyage" }] },
    { "id": 8, "type": "timeseries", "title": "Known-usage estimated USD (verified prices only, not invoices)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 }, "targets": [{ "refId": "A", "expr": "sum by (provider, model, account) (increase(prompter_provider_estimated_usd_total[1h]))", "legendFormat": "{{provider}} {{model}} {{account}}" }] },
    { "id": 9, "type": "stat", "title": "Seconds since durable index success (zero timestamp means never)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 0, "y": 32, "w": 8, "h": 6 }, "targets": [{ "refId": "A", "expr": "time() - max(prompter_state_last_success)" }] },
    { "id": 10, "type": "stat", "title": "Durable index failures / cancellations", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 8, "y": 32, "w": 8, "h": 6 }, "targets": [{ "refId": "A", "expr": "max(prompter_state_failures)", "legendFormat": "failures" }, { "refId": "B", "expr": "max(prompter_state_cancellations)", "legendFormat": "cancellations" }] },
    { "id": 11, "type": "stat", "title": "Last successful pages / chunks; last duration seconds", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 16, "y": 32, "w": 8, "h": 6 }, "targets": [{ "refId": "A", "expr": "max(prompter_state_documents)", "legendFormat": "pages" }, { "refId": "B", "expr": "max(prompter_state_chunks)", "legendFormat": "chunks" }, { "refId": "C", "expr": "max(prompter_state_duration_seconds)", "legendFormat": "duration" }] },
    { "id": 12, "type": "stat", "title": "Aggregate snapshot age seconds (No data is unhealthy)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 0, "y": 38, "w": 12, "h": 6 }, "targets": [{ "refId": "A", "expr": "time() - max(prompter_state_updated_at)" }] },
    { "id": 13, "type": "timeseries", "title": "Provider quota reset delay and retry backoff seconds", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "x": 12, "y": 38, "w": 12, "h": 6 }, "targets": [{ "refId": "A", "expr": "clamp_min(max(prompter_quota_primary_reset) - time(), 0)", "legendFormat": "primary quota reset delay" }, { "refId": "B", "expr": "sum by (provider) (rate(prompter_provider_backoff_seconds_sum[5m])) / clamp_min(sum by (provider) (rate(prompter_provider_backoff_seconds_count[5m])), 0.001)", "legendFormat": "{{provider}} mean backoff" }] }
  ]
}
