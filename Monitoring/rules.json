{
  "groups": [{
    "name": "prompter",
    "interval": "1m",
    "rules": [
      {
        "alert": "PrompterTelemetryMissing",
        "expr": "absent(prompter_state_updated_at) or (time() - max(prompter_state_updated_at) > 180)",
        "for": "5m",
        "labels": { "service": "prompter", "severity": "critical" },
        "annotations": { "summary": "Prompter aggregate telemetry is absent or stale", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#missing-telemetry" }
      },
      {
        "alert": "PrompterIndexFailed",
        "expr": "max(prompter_state_last_failure) > max(prompter_state_last_success)",
        "for": "2m",
        "labels": { "service": "prompter", "severity": "critical" },
        "annotations": { "summary": "A real indexing pipeline failed or was cancelled after its last success", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#index-failure" }
      },
      {
        "alert": "PrompterIndexStale",
        "expr": "time() - max(prompter_state_last_success) > 108000",
        "for": "15m",
        "labels": { "service": "prompter", "severity": "warning" },
        "annotations": { "summary": "No successful corpus refresh in 30 hours (or no success recorded yet)", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#index-failure" }
      },
      {
        "alert": "PrompterSpendExposure",
        "expr": "((max(prompter_state_anthropic_usd) + max(prompter_state_voyage_usd)) / clamp_min(max(prompter_limit_daily_usd), 0.001) >= 0.7) or (max(prompter_state_anthropic_usd) / clamp_min(max(prompter_limit_anthropic_daily_usd), 0.001) >= 0.7) or (max(prompter_state_voyage_usd) / clamp_min(max(prompter_limit_voyage_daily_usd), 0.001) >= 0.7)",
        "for": "5m",
        "labels": { "service": "prompter", "severity": "warning" },
        "annotations": { "summary": "UTC-day interactive reserved exposure reaches 70 percent of a protection ceiling", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#spend-and-protection" }
      },
      {
        "alert": "PrompterIndexSpendExposure",
        "expr": "max(prompter_state_index_usd) / clamp_min(max(prompter_limit_index_daily_usd), 0.001) >= 0.7",
        "for": "5m",
        "labels": { "service": "prompter", "severity": "warning" },
        "annotations": { "summary": "UTC-day retry-inclusive indexing exposure reaches 70 percent of its ceiling", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#spend-and-protection" }
      },
      {
        "alert": "PrompterSpendExposureHigh",
        "expr": "((max(prompter_state_anthropic_usd) + max(prompter_state_voyage_usd)) / clamp_min(max(prompter_limit_daily_usd), 0.001) >= 0.9) or (max(prompter_state_anthropic_usd) / clamp_min(max(prompter_limit_anthropic_daily_usd), 0.001) >= 0.9) or (max(prompter_state_voyage_usd) / clamp_min(max(prompter_limit_voyage_daily_usd), 0.001) >= 0.9)",
        "for": "5m",
        "labels": { "service": "prompter", "severity": "critical" },
        "annotations": { "summary": "UTC-day interactive reserved exposure reaches 90 percent of a protection ceiling", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#spend-and-protection" }
      },
      {
        "alert": "PrompterIndexSpendExposureHigh",
        "expr": "max(prompter_state_index_usd) / clamp_min(max(prompter_limit_index_daily_usd), 0.001) >= 0.9",
        "for": "5m",
        "labels": { "service": "prompter", "severity": "critical" },
        "annotations": { "summary": "UTC-day retry-inclusive indexing exposure reaches 90 percent of its ceiling", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#spend-and-protection" }
      },
      {
        "alert": "PrompterSpendHardCap",
        "expr": "((max(prompter_state_anthropic_usd) + max(prompter_state_voyage_usd)) / clamp_min(max(prompter_limit_daily_usd), 0.001) >= 1) or (max(prompter_state_anthropic_usd) / clamp_min(max(prompter_limit_anthropic_daily_usd), 0.001) >= 1) or (max(prompter_state_voyage_usd) / clamp_min(max(prompter_limit_voyage_daily_usd), 0.001) >= 1)",
        "for": "0s",
        "labels": { "service": "prompter", "severity": "critical" },
        "annotations": { "summary": "UTC-day interactive reserved exposure reaches a protection hard cap", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#spend-and-protection" }
      },
      {
        "alert": "PrompterIndexSpendHardCap",
        "expr": "max(prompter_state_index_usd) / clamp_min(max(prompter_limit_index_daily_usd), 0.001) >= 1",
        "for": "0s",
        "labels": { "service": "prompter", "severity": "critical" },
        "annotations": { "summary": "UTC-day retry-inclusive indexing exposure reaches its hard cap", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#spend-and-protection" }
      },
      {
        "alert": "PrompterProviderErrors",
        "expr": "(sum(rate(prompter_provider_duration_seconds_count{outcome=~\"provider_failure|auth|quota|capacity|rate_limit\"}[10m])) / clamp_min(sum(rate(prompter_provider_duration_seconds_count[10m])), 0.001) > 0.2) and (sum(increase(prompter_provider_attempts_total[10m])) >= 5)",
        "for": "5m",
        "labels": { "service": "prompter", "severity": "warning" },
        "annotations": { "summary": "More than 20 percent of provider attempts failed (at least five attempts)", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#provider-errors" }
      },
      {
        "alert": "PrompterProviderRateLimited",
        "expr": "sum(increase(prompter_events_total{reason=\"rate_limit\"}[10m])) >= 3",
        "for": "2m",
        "labels": { "service": "prompter", "severity": "warning" },
        "annotations": { "summary": "Provider rate limits repeatedly prevented dispatch", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#provider-errors" }
      },
      {
        "alert": "PrompterProviderUnavailable",
        "expr": "time() - max(prompter_event_last_seen{reason=~\"auth|quota|capacity_exhausted\"}) < 600",
        "for": "1m",
        "labels": { "service": "prompter", "severity": "critical" },
        "annotations": { "summary": "Provider auth, billing/quota or exhausted overload prevented work", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#provider-errors" }
      },
      {
        "alert": "PrompterAdmissionPressure",
        "expr": "sum(increase(prompter_events_total{source=~\"admission|protection\"}[10m])) >= 10",
        "for": "5m",
        "labels": { "service": "prompter", "severity": "warning" },
        "annotations": { "summary": "Admission or paid-work guards rejected repeated work", "runbook_url": "https://github.com/Cratis/Prompter/blob/main/Documentation/guides/monitoring.md#spend-and-protection" }
      }
    ]
  }]
}
